# Copy this file to .env and set your own values. Never commit .env.

# Database administrator password (used only inside the database container).
POSTGRES_PASSWORD=change-me-admin
# Password of the read-only role that the API uses.
PANORAMA_READER_PASSWORD=change-me-reader

# Folder with the data to load on first start. Default: synthetic placeholder data.
# For the real data, point this to the folder that holds the dump (see README.md).
PANORAMA_DB_INIT=./db/synthetic

# Banner on every page. Remove it when the site shows the real data.
PANORAMA_NOTICE=This site shows SYNTHETIC placeholder data. The values are not real.

# Port on the host for the website.
PANORAMA_HTTP_PORT=8080
